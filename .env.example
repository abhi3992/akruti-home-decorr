# Neon Postgres (use pooled URL for DATABASE_URL, direct for DIRECT_URL / migrations)
# Dashboard: https://console.neon.tech → Project → Connection details
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

ADMIN_PASSWORD="change-me-strong-password"

# Vercel Blob (recommended for large photo uploads on production)
# Create at: Vercel → Storage → Blob → connect to project
BLOB_READ_WRITE_TOKEN=""

# Razorpay — https://dashboard.razorpay.com/app/keys
# Use rzp_test_* for testing, rzp_live_* for real payments
# Never commit real secrets — set in local .env and Vercel project env
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# Order emails (buyer confirmation + optional shop alert)
# 1) Create free account: https://resend.com
# 2) API Keys → Create → paste below
# 3) For production: Domains → add akrutihomedecor.com and verify DNS
#    Until domain is verified, Resend only delivers to your own signup email
RESEND_API_KEY=""
ORDER_NOTIFY_EMAIL="you@example.com"
ORDER_NOTIFY_FROM="Akruti Home Decor <orders@akrutihomedecor.com>"

# WhatsApp alert to shop owner on every new order (pick ONE method)
ORDER_NOTIFY_WHATSAPP="+919351088793"
# Option A — Meta WhatsApp Cloud API (Business):
# WHATSAPP_CLOUD_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# Option B — CallMeBot (personal WhatsApp, quick):
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_APIKEY=""
